<!-- Theme toggler buttons -->
<!-- Initial style switch: light => dark -->
<button style="actionbar">
    <condition var1="theme_style" op="!=" var2="Black"/>
    <condition var1="theme_style" op="!=" var2="Dark"/>
    <condition var1="theme_style" op="!=" var2="Gray"/>
    <condition var1="theme_dark_old" op="!="/>
    <placement x="%ab_back_x%" y="%console_flash_y%" placement="4"/>
    <action function="set">theme_style_tmp=Dark</action>
    <action function="set">theme_style_act_tmp=Default</action>
    <action function="set">theme_accent_tmp=%theme_accent%</action>
    <action function="set">theme_accent_light_tmp=%theme_accent_light%</action>
    <action function="set">theme_accent_dark_tmp=%theme_accent_dark%</action>
    <action function="set">update_style=1</action>
    <action function="set">of_reload_back=main</action>
    <action function="set">theme_light_old=%theme_style%</action>
    <action function="overlay">apply_changes</action>
</button>

<!-- Initial style switch: dark => light -->
<button style="actionbar">
    <condition var1="theme_style" op="!=" var2="Cream"/>
    <condition var1="theme_style" op="!=" var2="Light"/>
    <condition var1="theme_dark_old" op="!="/>
