<image>
    <condition var1="theme_style" op="!=" var2="Black"/>
    <condition var1="theme_style" op="!=" var2="Dark"/>
    <condition var1="theme_style" op="!=" var2="Gray"/>
    <placement x="%ab_back_x%" y="%console_flash_y%" placement="4"/>
