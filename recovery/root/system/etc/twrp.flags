# mount point   fstype device                                   device2          flags
/data           ext4   /dev/block/bootdevice/by-name/userdata                    flags=fileencryption=aes-256-xts:aes-256-cts;metadata_encryption=aes-256-xts;fsflags="discard"
/metadata       ext4   /dev/block/bootdevice/by-name/oem                         flags=display="Metadata";fsflags="discard"
/cache          ext4   /dev/block/bootdevice/by-name/cache                       flags=display="Cache"

/boot           emmc   /dev/block/bootdevice/by-name/boot                        flags=display="Boot"
/recovery       emmc   /dev/block/bootdevice/by-name/recovery                    flags=display="Recovery";backup=1
/persist        ext4   /dev/block/platform/soc/7824900.sdhci/by-name/persist     flags=display="Persist";backup=1
/persist_image  emmc   /dev/block/platform/soc/7824900.sdhci/by-name/persist     flags=display="Persist Image";backup=1;flashimg=1

/firmware       vfat   /dev/block/platform/soc/7824900.sdhci/by-name/modem       flags=display="Firmware";fsflags="ro";mounttodecrypt

/modem          emmc   /dev/block/platform/soc/7824900.sdhci/by-name/modem       flags=backup=1;display="Modem"
/dsp            emmc   /dev/block/platform/soc/7824900.sdhci/by-name/dsp         flags=backup=1;display="DSP";subpartitionof=/modem

/efs1           emmc   /dev/block/platform/soc/7824900.sdhci/by-name/modemst1    flags=backup=1;display="EFS"
/efs2           emmc   /dev/block/platform/soc/7824900.sdhci/by-name/modemst2    flags=backup=1;subpartitionof=/efs1
/efsc           emmc   /dev/block/platform/soc/7824900.sdhci/by-name/fsc         flags=backup=1;subpartitionof=/efs1
/efsg           emmc   /dev/block/platform/soc/7824900.sdhci/by-name/fsg         flags=backup=1;subpartitionof=/efs1

# Removable storage
/sdcard1        auto   /dev/block/mmcblk1p1                     /dev/block/mmcblk1p4   flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto   /dev/block/sda1                          /dev/block/sda4  flags=display="USB OTG";storage;wipeingui;removable
